# Leave RUNNER_MODE unset to use synthetic demo agents.
RUNNER_MODE=demo
# RUNNER_MODE=openai-compatible
# MODEL_BASE_URL=https://your-provider.example/v1
# MODEL_NAME=your-model
# MODEL_API_KEY=your-server-side-key
# MODEL_TIMEOUT_MS=30000

# Optional: use only an authorized disposable Substrate workspace.
# SUBSTRATE_MCP_URL=https://your-authorized-host.example/mcp
# SUBSTRATE_MCP_BEARER=your-server-side-oauth-access-token
# SUBSTRATE_WORKSPACE_ID=your-workspace

# Optional authenticated fallback for Stooq HTTP 403:
# ALPHA_VANTAGE_API_KEY=your-key
